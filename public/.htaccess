# Les URL propres viennent de l'arborescence — /career/ est un dossier
# contenant index.html — et non d'une réécriture. Rien à maintenir ici,
# et rien qui casse si Apache change de version.

RewriteEngine on
RewriteOptions inherit

# Les anciennes adresses en .html, au cas où elles auraient été indexées
# ou partagées. Un 301 transmet l'ancienneté acquise à la nouvelle URL.
Redirect 301 /career_en.html https://francoisfournier.eu/career/
Redirect 301 /legal_en.html https://francoisfournier.eu/legal/
Redirect 301 /index_en.html https://francoisfournier.eu/

# Cache long sur les ressources empreintées ou stables.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png        "access plus 1 year"
  ExpiresByType image/jpeg       "access plus 1 year"
  ExpiresByType image/webp       "access plus 1 year"
  ExpiresByType font/woff2       "access plus 1 year"
  ExpiresByType text/css         "access plus 1 month"
  ExpiresByType text/html        "access plus 1 hour"
</IfModule>

# ──────────────────────────────────────────────────────────────────────
# En-têtes de sécurité.
#
# Un audit externe a relevé quatre signaux critiques ici, score 0/100 :
# aucun en-tête n'était envoyé. Vendre du conseil technique sans en-tête
# de sécurité est la même contradiction visible qu'un défaut RGPD.
#
# script-src n'a aucune exception — possible uniquement parce que le site
# ne charge rien de l'extérieur, et que le script de la page est passé
# dans /assets/app.js. C'est la règle « aucune ressource tierce » qui
# paie, et check-third-party.py qui la tient.
#
# style-src porte 'unsafe-inline' : la page emploie des attributs style=,
# auxquels ni un hash ni un nonce ne s'appliquent. L'injection de style
# est d'un ordre de gravité inférieur à l'injection de script.
# ──────────────────────────────────────────────────────────────────────

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
  Header always set X-Frame-Options "DENY"
</IfModule>
